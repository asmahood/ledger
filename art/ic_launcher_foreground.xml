<?xml version="1.0" encoding="utf-8"?>
<!--
  Ledger page mark. Stroke-only and single-colour so it survives being flattened into
  the <monochrome> layer on Android 13+ themed icons.

  All geometry sits within x, y in [36, 76]; with the 5dp stroke that stays inside the
  centred 66dp safe-zone circle (x, y in [21, 87]).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- page outline -->
    <path
        android:pathData="M40,32 L68,32 A4,4 0 0 1 72,36 L72,72 A4,4 0 0 1 68,76 L40,76 A4,4 0 0 1 36,72 L36,36 A4,4 0 0 1 40,32 Z"
        android:strokeColor="#9EF2E3"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
    <!-- entry lines -->
    <path
        android:pathData="M45,45 L63,45"
        android:strokeColor="#9EF2E3"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M45,55 L63,55"
        android:strokeColor="#9EF2E3"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M45,65 L56,65"
        android:strokeColor="#9EF2E3"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
</vector>
