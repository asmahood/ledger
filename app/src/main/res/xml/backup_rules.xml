<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup for Android 11 and below.

  The Room database is included deliberately: with CSV export (#19) still deferred,
  cloud backup is the only recovery path if the device is lost. Room runs in WAL mode,
  so a backup taken while the app is live is not transactionally consistent - including
  the whole database domain covers the -wal and -shm sidecars, but a restore can still
  land slightly behind the last write.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
