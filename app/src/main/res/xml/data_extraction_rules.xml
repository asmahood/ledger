<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup and device-to-device transfer for Android 12+.
  See backup_rules.xml for why the database is included.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
